{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ider-zh/wikidata-research/schemas/university_record.schema.json",
  "title": "Evidence-backed University Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity_type", "wikidata_qid", "identity", "names", "events", "claims", "evidence", "quality"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "entity_type": {"const": "university"},
    "wikidata_qid": {"type": "string", "pattern": "^Q[0-9]+$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name_en", "status", "institution_kind"],
      "properties": {
        "canonical_name_en": {"type": ["string", "null"]},
        "status": {"enum": ["verified", "unreviewed", "conflation_suspected", "conflation_confirmed", "unresolved"]},
        "institution_kind": {"enum": ["university", "university_system", "college", "campus", "historical_academy", "other", "unresolved"]},
        "related_entity_qids": {"type": "array", "items": {"type": "string", "pattern": "^Q[0-9]+$"}}
      }
    },
    "names": {"type": "array", "items": {"$ref": "#/$defs/name"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_status", "release_status"],
      "properties": {
        "verification_status": {"enum": ["pending", "passed", "failed", "needs_review"]},
        "release_status": {"enum": ["unreviewed", "agent_verified", "human_accepted", "excluded"]},
        "issues": {"type": "array", "items": {"type": "string"}},
        "approval_reference": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "time": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["earliest", "latest", "precision"],
      "properties": {
        "earliest": {"type": ["string", "null"]},
        "latest": {"type": ["string", "null"]},
        "precision": {"enum": ["day", "month", "year", "decade", "century", "interval", "unknown"]},
        "calendar_model_qid": {"type": ["string", "null"]},
        "original_expression": {"type": ["string", "null"]}
      }
    },
    "place": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["place_qid", "name_original", "name_en", "location_precision"],
      "properties": {
        "place_qid": {"type": ["string", "null"]},
        "name_original": {"type": ["string", "null"]},
        "name_en": {"type": ["string", "null"]},
        "location_precision": {"enum": ["point", "settlement", "region", "country", "unknown"]},
        "historical_polity_qids": {"type": "array", "items": {"type": "string"}},
        "modern_country_qid": {"type": ["string", "null"]},
        "country_assignment_method": {"type": ["string", "null"]}
      }
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "language", "valid_time", "evidence_ids"],
      "properties": {
        "value": {"type": "string"},
        "language": {"type": "string"},
        "normalized_en": {"type": ["string", "null"]},
        "valid_time": {"$ref": "#/$defs/time"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "time", "place", "description_en", "evidence_ids"],
      "properties": {
        "event_id": {"type": "string"},
        "event_type": {"enum": ["founded", "opened", "renamed", "relocated", "merged", "split", "closed", "reopened", "status_changed", "affiliation_changed", "campus_opened", "campus_closed", "other"]},
        "time": {"$ref": "#/$defs/time"},
        "place": {"$ref": "#/$defs/place"},
        "other_place": {"$ref": "#/$defs/place"},
        "participant_entity_qids": {"type": "array", "items": {"type": "string"}},
        "description_en": {"type": ["string", "null"]},
        "confidence": {"enum": ["high", "medium", "low", "unresolved"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "predicate_en", "value", "status", "evidence_ids"],
      "properties": {
        "claim_id": {"type": "string"},
        "predicate_en": {"type": "string"},
        "value": {},
        "valid_time": {"$ref": "#/$defs/time"},
        "status": {"enum": ["verified", "disputed", "insufficient_evidence"]},
        "wikidata_statement_id": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_kind", "source_language", "source_url", "original_excerpt"],
      "properties": {
        "evidence_id": {"type": "string"},
        "source_kind": {"enum": ["wikidata", "wikipedia", "historical_gazetteer", "other"]},
        "source_language": {"type": ["string", "null"]},
        "source_url": {"type": "string", "format": "uri"},
        "page_id": {"type": ["integer", "null"]},
        "revision_id": {"type": ["integer", "null"]},
        "section": {"type": ["string", "null"]},
        "original_excerpt": {"type": ["string", "null"]},
        "accessed_at": {"type": ["string", "null"]},
        "license_id": {"type": ["string", "null"]}
      }
    }
  }
}
